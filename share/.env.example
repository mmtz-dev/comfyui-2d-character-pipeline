# Copy to .env and set a real password:
#   cp share/.env.example share/.env
#   python3 -c 'import secrets,string; print("SMB_PASS=" + "".join(secrets.choice(string.ascii_letters+string.digits) for _ in range(24)))' >> share/.env
#
# .env is gitignored. .env.example is committed and must never hold a real password.

# The SMB account the Mac logs in as. Must be a real account name, not "guest" —
# the share refuses anonymous access on purpose.
SMB_USER=workstation

# The SMB password. Generate a random one; do not reuse a login password.
SMB_PASS=replace-me-with-a-random-password

# Host port published on the LAN. 445 is already taken by this host's own smbd
# (systemd smb.service, shares Storage/Private/homes), so this share uses 8445.
# macOS Finder accepts a port in the URL: smb://192.168.1.158:8445/game02-assets
SMB_PORT=8445
